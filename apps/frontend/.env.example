# The public SEO/canonical origin is intentionally fixed in lib/canonical-host.ts
# so preview or deployment URLs can never replace the official campaign domain.
NEXT_PUBLIC_API_URL=http://localhost:4000

NEXT_PUBLIC_ENABLE_ANALYTICS=true

# Cloudflare Turnstile — get from dash.cloudflare.com/turnstile
# Test site key (always passes): 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
